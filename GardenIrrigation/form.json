{
  "elements": [

    { "type": "Label", "bold": true, "caption": "── Ventile ──────────────────────────────────────────" },
    { "name": "MainValveID",  "type": "SelectVariable", "caption": "Hauptventil",                       "validVariableTypes": [0] },
    { "name": "ValveRasenID", "type": "SelectVariable", "caption": "Ventil Zone Rasen",                 "validVariableTypes": [0] },
    { "name": "ValveHeckeID", "type": "SelectVariable", "caption": "Ventil Zone Hecke",                 "validVariableTypes": [0] },
    { "name": "ValveHangID",    "type": "SelectVariable", "caption": "Ventil Hang / Hecke Garage (gemeinsamer Eingang)", "validVariableTypes": [0] },
    { "name": "ValveHang2ID",  "type": "SelectVariable", "caption": "Ventil Ausgang Hang",                              "validVariableTypes": [0] },
    { "name": "ValveGarageID", "type": "SelectVariable", "caption": "Ventil Ausgang Hecke Garage",                     "validVariableTypes": [0] },

    { "type": "Label", "bold": true, "caption": "── Pumpe & Sensoren ─────────────────────────────────" },
    { "name": "FertPumpID",   "type": "SelectVariable", "caption": "Dünger-Pumpe",                      "validVariableTypes": [0] },
    { "name": "SoilHeckeID",  "type": "SelectVariable", "caption": "Bodenfeuchte Hecke (%)",            "validVariableTypes": [1] },
    { "name": "SoilHangID",   "type": "SelectVariable", "caption": "Bodenfeuchte Hang (%)",             "validVariableTypes": [1] },
    { "name": "RainSensorID", "type": "SelectVariable", "caption": "Regensensor (mm, Float)",           "validVariableTypes": [2] },
    { "name": "TempSensorID", "type": "SelectVariable", "caption": "Temperatursensor (°C)",             "validVariableTypes": [2] },
    { "name": "FlowCounterID","type": "SelectVariable", "caption": "Durchflussmesser – absoluter Zähler (Float)", "validVariableTypes": [2] },

    { "type": "Label", "bold": true, "caption": "── Durchflussmesser-Kalibrierung  K = A·ln(Q) + B ──" },
    { "type": "Label", "caption": "Voreinstellung aus Kennlinie: A = 149,71 · ln(Q) + 65,507" },
    { "name": "FlowCalibA", "type": "NumberSpinner", "caption": "Faktor A", "digits": 3, "minimum": 1, "maximum": 500 },
    { "name": "FlowCalibB", "type": "NumberSpinner", "caption": "Offset B", "digits": 3, "minimum": 0, "maximum": 500 },

    { "type": "Label", "bold": true, "caption": "── Aktionen ─────────────────────────────────────────" },
    { "type": "Button", "caption": "Alle Ventile schließen (Notaus)",   "onClick": "GardenIrr_StopAll($id);" },
    { "type": "Button", "caption": "Zeitplan neu berechnen",            "onClick": "GardenIrr_RescheduleNow($id);" }
  ]
}
