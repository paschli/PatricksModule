{
  "elements": [

    { "type": "Label", "bold": true, "caption": "── Ventile ──────────────────────────────────────────" },
    { "name": "MainValveID",  "type": "SelectVariable", "caption": "Hauptventil",                       "validVariableTypes": [0] },
    { "name": "ValveRasenID", "type": "SelectVariable", "caption": "Ventil Zone Rasen",                 "validVariableTypes": [0] },
    { "name": "ValveHeckeID", "type": "SelectVariable", "caption": "Ventil Zone Hecke",                 "validVariableTypes": [0] },
    { "name": "ValveHangID",  "type": "SelectVariable", "caption": "Ventil Zone Hang (+ Hecke Garage)", "validVariableTypes": [0] },
    { "name": "ValveYID",     "type": "SelectVariable", "caption": "Y-Ventil  (false = Hang  /  true = Hecke Garage)", "validVariableTypes": [0] },

    { "type": "Label", "bold": true, "caption": "── Pumpe & Sensoren ─────────────────────────────────" },
    { "name": "FertPumpID",   "type": "SelectVariable", "caption": "Dünger-Pumpe",                      "validVariableTypes": [0] },
    { "name": "SoilHeckeID",  "type": "SelectVariable", "caption": "Bodenfeuchte Hecke (%)",            "validVariableTypes": [2] },
    { "name": "SoilHangID",   "type": "SelectVariable", "caption": "Bodenfeuchte Hang (%)",             "validVariableTypes": [2] },
    { "name": "RainSensorID", "type": "SelectVariable", "caption": "Regensensor (Boolean)",             "validVariableTypes": [0] },
    { "name": "TempSensorID", "type": "SelectVariable", "caption": "Temperatursensor (°C)",             "validVariableTypes": [2] },
    { "name": "FlowCounterID","type": "SelectVariable", "caption": "Durchflussmesser – absoluter Zähler (Integer)", "validVariableTypes": [1] },

    { "type": "Label", "bold": true, "caption": "── Durchflussmesser-Kalibrierung  K = A·ln(Q) + B ──" },
    { "type": "Label", "caption": "Voreinstellung aus Kennlinie: A = 149,71 · ln(Q) + 65,507" },
    { "name": "FlowCalibA", "type": "NumberSpinner", "caption": "Faktor A", "digits": 3, "minimum": 1, "maximum": 500 },
    { "name": "FlowCalibB", "type": "NumberSpinner", "caption": "Offset B", "digits": 3, "minimum": 0, "maximum": 500 },

    { "type": "Label", "bold": true, "caption": "── Zone 1: Rasen ────────────────────────────────────" },
    { "name": "RasenEnabled",      "type": "CheckBox",     "caption": "Zone aktiv" },
    { "name": "RasenTargetLiters", "type": "NumberSpinner","caption": "Ziel-Volumen (Liter)", "digits": 1, "minimum": 1, "maximum": 500 },
    { "name": "RasenMaxLiters",    "type": "NumberSpinner","caption": "Max. Volumen Sicherheit (Liter)", "digits": 1, "minimum": 10, "maximum": 1000 },
    { "name": "RasenFertEnabled",  "type": "CheckBox",     "caption": "Düngung aktiv" },
    { "name": "RasenFertMlPerL",   "type": "NumberSpinner","caption": "Düngermenge (ml/Liter)", "digits": 2, "minimum": 0, "maximum": 50 },
    { "name": "RasenScheduleTime", "type": "SelectTime",   "caption": "Bewässerungszeit" },
    { "type": "Label", "caption": "Aktive Wochentage:" },
    { "name": "RasenDayMo", "type": "CheckBox", "caption": "Montag" },
    { "name": "RasenDayDi", "type": "CheckBox", "caption": "Dienstag" },
    { "name": "RasenDayMi", "type": "CheckBox", "caption": "Mittwoch" },
    { "name": "RasenDayDo", "type": "CheckBox", "caption": "Donnerstag" },
    { "name": "RasenDayFr", "type": "CheckBox", "caption": "Freitag" },
    { "name": "RasenDaySa", "type": "CheckBox", "caption": "Samstag" },
    { "name": "RasenDaySo", "type": "CheckBox", "caption": "Sonntag" },

    { "type": "Label", "bold": true, "caption": "── Zone 2: Hecke ────────────────────────────────────" },
    { "name": "HeckeEnabled",      "type": "CheckBox",     "caption": "Zone aktiv" },
    { "name": "HeckeTargetLiters", "type": "NumberSpinner","caption": "Ziel-Volumen (Liter)", "digits": 1, "minimum": 1, "maximum": 500 },
    { "name": "HeckeMaxLiters",    "type": "NumberSpinner","caption": "Max. Volumen Sicherheit (Liter)", "digits": 1, "minimum": 10, "maximum": 1000 },
    { "name": "HeckeMoistureThreshold", "type": "NumberSpinner", "caption": "Bodenfeuchte-Schwelle – nicht bewässern wenn ≥ (%) ", "digits": 1, "minimum": 0, "maximum": 100 },
    { "name": "HeckeFertEnabled",  "type": "CheckBox",     "caption": "Düngung aktiv" },
    { "name": "HeckeFertMlPerL",   "type": "NumberSpinner","caption": "Düngermenge (ml/Liter)", "digits": 2, "minimum": 0, "maximum": 50 },
    { "name": "HeckeScheduleTime", "type": "SelectTime",   "caption": "Bewässerungszeit" },
    { "type": "Label", "caption": "Aktive Wochentage:" },
    { "name": "HeckeDayMo", "type": "CheckBox", "caption": "Montag" },
    { "name": "HeckeDayDi", "type": "CheckBox", "caption": "Dienstag" },
    { "name": "HeckeDayMi", "type": "CheckBox", "caption": "Mittwoch" },
    { "name": "HeckeDayDo", "type": "CheckBox", "caption": "Donnerstag" },
    { "name": "HeckeDayFr", "type": "CheckBox", "caption": "Freitag" },
    { "name": "HeckeDaySa", "type": "CheckBox", "caption": "Samstag" },
    { "name": "HeckeDaySo", "type": "CheckBox", "caption": "Sonntag" },

    { "type": "Label", "bold": true, "caption": "── Zone 3: Hang ─────────────────────────────────────" },
    { "name": "HangEnabled",      "type": "CheckBox",     "caption": "Zone aktiv" },
    { "name": "HangTargetLiters", "type": "NumberSpinner","caption": "Ziel-Volumen (Liter)", "digits": 1, "minimum": 1, "maximum": 500 },
    { "name": "HangMaxLiters",    "type": "NumberSpinner","caption": "Max. Volumen Sicherheit (Liter)", "digits": 1, "minimum": 10, "maximum": 1000 },
    { "name": "HangMoistureThreshold", "type": "NumberSpinner", "caption": "Bodenfeuchte-Schwelle – nicht bewässern wenn ≥ (%)", "digits": 1, "minimum": 0, "maximum": 100 },
    { "name": "HangFertEnabled",  "type": "CheckBox",     "caption": "Düngung aktiv" },
    { "name": "HangFertMlPerL",   "type": "NumberSpinner","caption": "Düngermenge (ml/Liter)", "digits": 2, "minimum": 0, "maximum": 50 },
    { "name": "HangScheduleTime", "type": "SelectTime",   "caption": "Bewässerungszeit" },
    { "type": "Label", "caption": "Aktive Wochentage:" },
    { "name": "HangDayMo", "type": "CheckBox", "caption": "Montag" },
    { "name": "HangDayDi", "type": "CheckBox", "caption": "Dienstag" },
    { "name": "HangDayMi", "type": "CheckBox", "caption": "Mittwoch" },
    { "name": "HangDayDo", "type": "CheckBox", "caption": "Donnerstag" },
    { "name": "HangDayFr", "type": "CheckBox", "caption": "Freitag" },
    { "name": "HangDaySa", "type": "CheckBox", "caption": "Samstag" },
    { "name": "HangDaySo", "type": "CheckBox", "caption": "Sonntag" },

    { "type": "Label", "bold": true, "caption": "── Zone 4: Hecke Garage ─────────────────────────────" },
    { "name": "GarageEnabled",      "type": "CheckBox",     "caption": "Zone aktiv" },
    { "name": "GarageTargetLiters", "type": "NumberSpinner","caption": "Ziel-Volumen (Liter)", "digits": 1, "minimum": 1, "maximum": 500 },
    { "name": "GarageMaxLiters",    "type": "NumberSpinner","caption": "Max. Volumen Sicherheit (Liter)", "digits": 1, "minimum": 10, "maximum": 1000 },
    { "name": "GarageFertEnabled",  "type": "CheckBox",     "caption": "Düngung aktiv" },
    { "name": "GarageFertMlPerL",   "type": "NumberSpinner","caption": "Düngermenge (ml/Liter)", "digits": 2, "minimum": 0, "maximum": 50 },
    { "name": "GarageScheduleTime", "type": "SelectTime",   "caption": "Bewässerungszeit" },
    { "type": "Label", "caption": "Aktive Wochentage:" },
    { "name": "GarageDayMo", "type": "CheckBox", "caption": "Montag" },
    { "name": "GarageDayDi", "type": "CheckBox", "caption": "Dienstag" },
    { "name": "GarageDayMi", "type": "CheckBox", "caption": "Mittwoch" },
    { "name": "GarageDayDo", "type": "CheckBox", "caption": "Donnerstag" },
    { "name": "GarageDayFr", "type": "CheckBox", "caption": "Freitag" },
    { "name": "GarageDaySa", "type": "CheckBox", "caption": "Samstag" },
    { "name": "GarageDaySo", "type": "CheckBox", "caption": "Sonntag" },

    { "type": "Label", "bold": true, "caption": "── Dünger-Steuerung ─────────────────────────────────" },
    { "name": "FertEnabled",      "type": "CheckBox",     "caption": "Dünger-Funktion global aktivieren" },
    { "name": "FertDelaySeconds", "type": "NumberSpinner","caption": "Verzögerung Pumpenstart nach Ventilöffnung (Sek.)", "minimum": 0, "maximum": 120 },
    { "name": "FertFlushLiters",  "type": "NumberSpinner","caption": "Pumpe stoppen X Liter vor Zonenende (Spülung)", "digits": 1, "minimum": 0, "maximum": 20 },

    { "type": "Label", "bold": true, "caption": "── Sensorschwellen & Anpassung ──────────────────────" },
    { "name": "RainBlockHours",    "type": "NumberSpinner","caption": "Regen-Sperrzeit nach Regen-Ereignis (Stunden)", "minimum": 0, "maximum": 72 },
    { "name": "TempBoostThreshold","type": "NumberSpinner","caption": "Temperatur-Boost ab (°C)", "digits": 1, "minimum": 15, "maximum": 45 },
    { "name": "TempBoostPercent",  "type": "NumberSpinner","caption": "Volumen-Boost pro 5°C über Schwelle (%)", "digits": 1, "minimum": 0, "maximum": 50 },
    { "name": "LeakFlowThreshold", "type": "NumberSpinner","caption": "Leck-Erkennung: Durchfluss-Alarm ab (l/min) bei geschlossenen Ventilen", "digits": 1, "minimum": 0.1, "maximum": 10 },
    { "name": "MaxZoneRuntimeMin", "type": "NumberSpinner","caption": "Sicherheits-Timeout je Zone (Minuten)", "minimum": 5, "maximum": 180 },
    { "name": "WaterPrice",        "type": "NumberSpinner","caption": "Wasserpreis (€/m³) für Kostenberechnung", "digits": 2, "minimum": 0, "maximum": 20 },

    { "type": "Label", "bold": true, "caption": "── Aktionen ─────────────────────────────────────────" },
    { "type": "Button", "caption": "Alle Ventile schließen (Notaus)",   "onClick": "GardenIrr_StopAll($id);" },
    { "type": "Button", "caption": "Zeitplan neu berechnen",            "onClick": "GardenIrr_RescheduleNow($id);" }
  ]
}
